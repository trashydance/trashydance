# Database
DATABASE_URL=data/trashydance.db

# Better Auth
# BETTER_AUTH_URL (required): public origin of the app, also used as Socket.IO CORS origin
BETTER_AUTH_URL=https://localhost
# BETTER_AUTH_SECRET (required, min 32 chars): generate with `openssl rand -hex 32`
BETTER_AUTH_SECRET=change-me-generate-with-openssl-rand-hex-32
BETTER_AUTH_TELEMETRY=0

# 42 OAuth (required): credentials from https://profile.intra.42.fr/oauth/applications
FORTYTWO_CLIENT_ID=your-42-client-id
FORTYTWO_CLIENT_SECRET=your-42-client-secret

# Server
PORT=3000
NODE_ENV=development
