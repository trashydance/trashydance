# Example environment variables for local development
# Do NOT commit real secrets. Use this file as a template.

# Database
DATABASE_URL=./data/local.db

# Better Auth
# BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=changeme_generate_a_secure_32_char_secret
BETTER_AUTH_TELEMETRY=0

# 42 OAuth
FORTYTWO_CLIENT_ID=your_42_client_id
FORTYTWO_CLIENT_SECRET=your_42_client_secret

# Server
HOSTNAME=localhost
PORT=3000
NODE_ENV=development

# Notes:
# - Use http://localhost:3000 in the browser during local development.
# - Better Auth rejects origins coming from http://0.0.0.0:3000.
# - Replace the placeholder secrets with real values in production.
# - Prefer using a secrets manager or Docker secrets for production deployments.
